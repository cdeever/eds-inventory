# Hugo (docs/). The theme is a submodule; public/ and resources/ are build
# output, and .hugo_build.lock is a transient held only while hugo runs.
docs/public/
docs/resources/
docs/.hugo_build.lock

# macOS
.DS_Store

# Go builds, and inventories made while developing: an owner's library is
# never committed, nor anything made from it.
services/*/bin/
*.db
*.db-shm
*.db-wal
