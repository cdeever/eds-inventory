{
  "openapi": "3.1.0",
  "info": {
    "title": "eds-inventory",
    "version": "1",
    "description": "One inventory of the owner's music, in every format. Every answer carries \"v\": 1. An answer the inventory is not sure of is null, with the score it reached."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Whether the service is up",
        "responses": { "200": { "description": "ok", "content": { "text/plain": {} } } }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "responses": { "200": { "description": "The contract", "content": { "application/json": {} } } }
      }
    },
    "/v1/artists/find": {
      "get": {
        "summary": "The artist nearest a name",
        "description": "Spelling and sound are both weighed, for names written down from speech, against the artist's name and the aliases MusicBrainz knows them by. Below 0.90 the artist is null.",
        "parameters": [ { "name": "name", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": {
            "description": "The nearest artist, or null",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "name", "score", "artist"],
              "properties": {
                "v": { "const": 1 },
                "name": { "type": "string", "description": "The name asked for" },
                "score": { "type": "number", "minimum": 0, "maximum": 1 },
                "artist": { "oneOf": [ { "$ref": "#/components/schemas/Artist" }, { "type": "null" } ] }
              }
            } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/artists/{id}": {
      "get": {
        "summary": "An artist and their albums",
        "parameters": [ { "$ref": "#/components/parameters/ArtistID" } ],
        "responses": {
          "200": {
            "description": "The artist",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "artist"],
              "properties": { "v": { "const": 1 }, "artist": { "$ref": "#/components/schemas/Artist" } }
            } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/artists/{id}/albums/find": {
      "get": {
        "summary": "One of an artist's albums, by title",
        "description": "One title: the nearest album, with its score; below 0.90 it is null. Several titles, or studio=true: an album's names as a catalog gives them, main one first; the answer is the first the inventory has, never a compilation, and title says which name found it.",
        "parameters": [
          { "$ref": "#/components/parameters/ArtistID" },
          { "name": "title", "in": "query", "required": true, "schema": { "type": "array", "items": { "type": "string" } }, "style": "form", "explode": true },
          { "name": "studio", "in": "query", "required": false, "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "The album, or null",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "title", "album"],
              "properties": {
                "v": { "const": 1 },
                "title": { "type": ["string", "null"], "description": "The title asked for, or the one that found the album" },
                "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Only when one title was asked for" },
                "album": { "oneOf": [ { "$ref": "#/components/schemas/Album" }, { "type": "null" } ] }
              }
            } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/albums/find": {
      "get": {
        "summary": "Albums by title, whoever they are by",
        "description": "Each artist's album nearest the title, if 0.90 or nearer, nearest first, then by artist. For an album asked for without its artist (EdS ADR-0055): one artist is the album, more are a question.",
        "parameters": [
          { "name": "title", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The albums, perhaps none",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "title", "albums"],
              "properties": {
                "v": { "const": 1 },
                "title": { "type": "string" },
                "albums": { "type": "array", "items": {
                  "type": "object",
                  "required": ["artist", "album", "score"],
                  "properties": {
                    "artist": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
                    "album": { "$ref": "#/components/schemas/Album" },
                    "score": { "type": "number", "minimum": 0.9, "maximum": 1 }
                  }
                } }
              }
            } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/artists/{id}/albums/nth": {
      "get": {
        "summary": "The Nth album of an artist's that the owner has",
        "description": "Counted among the artist's studio albums as MusicBrainz orders them (order musicbrainz), each looked for under its own title and its releases' other names; the Nth if owned, else the next that is. Before the artist is enriched, the owner's own albums by year (order library), and the artist is put first in line to be enriched. Never a compilation.",
        "parameters": [
          { "$ref": "#/components/parameters/ArtistID" },
          { "name": "n", "in": "query", "required": true, "schema": { "type": "integer", "not": { "const": 0 } }, "description": "1 for the first, -1 for the latest" },
          { "name": "instead", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 20, "default": 6 }, "description": "How many of the owner's albums after it to give" }
        ],
        "responses": {
          "200": {
            "description": "The album, or null",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "n", "order", "counted", "album", "instead"],
              "properties": {
                "v": { "const": 1 },
                "n": { "type": "integer" },
                "order": { "enum": ["musicbrainz", "library"] },
                "counted": { "oneOf": [ { "$ref": "#/components/schemas/StudioAlbum" }, { "type": "null" } ], "description": "The Nth studio album as MusicBrainz counts it, owned or not" },
                "album": { "oneOf": [ { "$ref": "#/components/schemas/Album" }, { "type": "null" } ] },
                "instead": { "type": "array", "items": { "$ref": "#/components/schemas/Album" } }
              }
            } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/artists/{id}/discography": {
      "get": {
        "summary": "An artist's studio albums, and which the owner has",
        "description": "Null before the artist is enriched, and the artist is put first in line.",
        "parameters": [ { "$ref": "#/components/parameters/ArtistID" } ],
        "responses": {
          "200": {
            "description": "The discography, or null",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "artist", "discography"],
              "properties": {
                "v": { "const": 1 },
                "artist": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
                "discography": { "oneOf": [ { "type": "null" }, {
                  "type": "object",
                  "required": ["name", "found", "fetched", "aliases", "albums"],
                  "properties": {
                    "name": { "type": "string", "description": "The artist as MusicBrainz names them" },
                    "found": { "type": "boolean", "description": "False when MusicBrainz knows no such artist, or no studio album by them" },
                    "fetched": { "type": "string", "format": "date-time" },
                    "aliases": { "type": "array", "items": { "type": "string" } },
                    "albums": { "type": "array", "items": {
                      "type": "object",
                      "properties": {
                        "studio_album": { "$ref": "#/components/schemas/StudioAlbum" },
                        "owned": { "oneOf": [ { "$ref": "#/components/schemas/Album" }, { "type": "null" } ] }
                      }
                    } }
                  }
                } ] }
              }
            } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/artists/{id}/albums/by-year": {
      "get": {
        "summary": "An artist's own albums by year",
        "description": "Without compilations, and without what is named as one (greatest hits, live, best of). Albums with no year come last.",
        "parameters": [ { "$ref": "#/components/parameters/ArtistID" } ],
        "responses": {
          "200": {
            "description": "The albums, earliest first",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["v", "albums"],
              "properties": { "v": { "const": 1 }, "albums": { "type": "array", "items": { "$ref": "#/components/schemas/Album" } } }
            } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ArtistID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "The inventory's own ID for the artist, ar_ and twelve hex digits" }
    },
    "schemas": {
      "Artist": {
        "type": "object",
        "required": ["id", "name", "albums"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "albums": { "type": "array", "items": { "$ref": "#/components/schemas/Album" } }
        }
      },
      "StudioAlbum": {
        "type": "object",
        "required": ["title", "release_group"],
        "properties": {
          "title": { "type": "string", "description": "As MusicBrainz names it, with straight quotes" },
          "released": { "type": "string", "description": "Its first release, YYYY[-MM[-DD]]" },
          "release_group": { "type": "string", "description": "MusicBrainz's release group id" },
          "other_titles": { "type": "array", "items": { "type": "string" }, "description": "Names its releases have gone by, when asked for" }
        }
      },
      "Album": {
        "type": "object",
        "required": ["id", "title", "tracks", "sources"],
        "properties": {
          "id": { "type": "string", "description": "The inventory's own ID, al_ and twelve hex digits; kept across collections" },
          "title": { "type": "string", "description": "As the source spells it, so a player asked for it by name finds it" },
          "year": { "type": "integer" },
          "tracks": { "type": "integer" },
          "compilation": { "type": "boolean" },
          "sources": { "type": "array", "items": { "type": "string" }, "description": "The sources that hold it, such as itunes" }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "The question could not be answered",
        "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["v", "error"],
          "properties": { "v": { "const": 1 }, "error": { "type": "string" } }
        } } }
      }
    }
  }
}
