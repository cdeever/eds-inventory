// The inventory's database as proposed, not yet built (review started
// 2026-10-24). Drawn by GraphViz: `make -C docs diagrams` writes
// schema-proposed.svg beside this file, and both are committed. Tables
// agreed are in color; those still to review, or not yet agreed, are gray.
digraph schema_proposed {
    graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.9,
           fontname="Helvetica,Arial,sans-serif"];
    node  [shape=plaintext, fontname="Helvetica,Arial,sans-serif", fontsize=11];
    edge  [color="#5b6470", arrowsize=0.7, fontname="Helvetica,Arial,sans-serif", fontsize=9, fontcolor="#3a4048"];

    holding_track [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c79a9a">
        <tr><td bgcolor="#f3d6d6" colspan="2"><b>holding_track</b></td></tr>
        <tr><td align="left"><b>holding_id</b></td><td port="holding" align="left">TEXT · PK · FK</td></tr>
        <tr><td align="left"><b>track_id</b></td><td port="track" align="left">TEXT · PK · FK</td></tr>
        <tr><td align="left">source_key</td><td align="left">TEXT</td></tr>
      </table>>];

    holding [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#d9b77a">
        <tr><td bgcolor="#fbe2b6" colspan="2"><b>holding</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">source_id</td><td port="source" align="left">TEXT · FK</td></tr>
        <tr><td align="left">source_key</td><td align="left">TEXT · UNIQUE with source</td></tr>
        <tr><td align="left">edition_id</td><td port="edition" align="left">TEXT · FK</td></tr>
        <tr><td align="left">source_title</td><td align="left">TEXT</td></tr>
        <tr><td align="left">encoding</td><td align="left">TEXT · NULL</td></tr>
        <tr><td align="left">bitrate_kbps</td><td align="left">INTEGER · NULL</td></tr>
        <tr><td align="left">sample_rate_hz</td><td align="left">INTEGER · NULL</td></tr>
        <tr><td align="left">bit_depth</td><td align="left">INTEGER · NULL</td></tr>
        <tr><td align="left">collected_at</td><td align="left">TEXT (RFC 3339)</td></tr>
      </table>>];

    source [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9db4cf">
        <tr><td bgcolor="#dbe7f5" colspan="2"><b>source</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">last_collected_at</td><td align="left">TEXT · NULL</td></tr>
      </table>>];

    collection_run [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#b8bcc2">
        <tr><td bgcolor="#e6e8eb" colspan="2"><b>collection_run</b> (not agreed)</td></tr>
        <tr><td align="left">source_id</td><td port="source" align="left">TEXT · FK</td></tr>
        <tr><td align="left">started_at</td><td align="left">TEXT</td></tr>
        <tr><td align="left">added · kept · removed</td><td align="left">INTEGER</td></tr>
      </table>>];

    track [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c79a9a">
        <tr><td bgcolor="#f3d6d6" colspan="2"><b>track</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">edition_id</td><td port="edition" align="left">TEXT · FK</td></tr>
        <tr><td align="left">disc</td><td align="left">INTEGER · NULL</td></tr>
        <tr><td align="left">number</td><td align="left">INTEGER · NULL</td></tr>
        <tr><td align="left">recording_id</td><td port="recording" align="left">TEXT · FK</td></tr>
      </table>>];

    edition [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#d6c06a">
        <tr><td bgcolor="#fdecb0" colspan="2"><b>edition</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">album_id</td><td port="album" align="left">TEXT · FK</td></tr>
        <tr><td align="left">medium</td><td align="left">TEXT · NULL</td></tr>
        <tr><td align="left">year</td><td align="left">INTEGER · NULL</td></tr>
        <tr><td align="left">variant</td><td align="left">TEXT · NULL</td></tr>
        <tr><td align="left">is_identified</td><td align="left">INTEGER (0/1)</td></tr>
      </table>>];

    recording [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c79a9a">
        <tr><td bgcolor="#f3d6d6" colspan="2"><b>recording</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">title</td><td align="left">TEXT</td></tr>
        <tr><td align="left">artist_id</td><td port="artist" align="left">TEXT · FK</td></tr>
        <tr><td align="left">length_ms</td><td align="left">INTEGER · NULL</td></tr>
      </table>>];

    album [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#d6c06a">
        <tr><td bgcolor="#fdecb0" colspan="2"><b>album</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td port="idr" align="left">TEXT · PK</td></tr>
        <tr><td align="left">artist_id</td><td port="artist" align="left">TEXT · FK · NULL</td></tr>
        <tr><td align="left">title</td><td align="left">TEXT</td></tr>
        <tr><td align="left">released</td><td align="left">TEXT (ISO date) · NULL</td></tr>
        <tr><td align="left">kind</td><td align="left">TEXT · NULL</td></tr>
      </table>>];

    artist [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#8fbf9f">
        <tr><td bgcolor="#cfe9d8" colspan="2"><b>artist</b></td></tr>
        <tr><td port="id" align="left"><b>id</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">name</td><td align="left">TEXT</td></tr>
        <tr><td align="left">folded</td><td align="left">TEXT · UNIQUE</td></tr>
        <tr><td align="left">kind</td><td align="left">TEXT · NULL</td></tr>
      </table>>];

    refs [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#a99bd0">
        <tr><td bgcolor="#e2dcf5" colspan="2"><b>artist_ref · album_ref · edition_ref · recording_ref</b></td></tr>
        <tr><td port="owner" align="left"><b>…_id</b></td><td align="left">TEXT · PK · FK (ours)</td></tr>
        <tr><td align="left"><b>service</b></td><td align="left">TEXT · PK</td></tr>
        <tr><td align="left">ref</td><td align="left">TEXT · UNIQUE with service</td></tr>
      </table>>];

    to_review [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#b8bcc2">
        <tr><td bgcolor="#e6e8eb"><b>still to review</b></td></tr>
        <tr><td align="left">artist_alias</td></tr>
        <tr><td align="left">album_alias (was release_titles)</td></tr>
        <tr><td align="left">discography (enrichment status)</td></tr>
        <tr><td align="left">enrichment (the counter)</td></tr>
      </table>>];

    holding_track:holding:e -> holding:id:w [label="which tracks\nthis copy has"];
    holding_track:track:e -> track:id:w;
    holding:source:e -> source:id:w [label="its source"];
    collection_run:source:e -> source:id:w [style=dashed];
    holding:edition:e -> edition:id:w [label="a copy of\none edition"];
    track:edition:e -> edition:id:w [label="the edition's\ntrack list"];
    track:recording:e -> recording:id:w [label="the song\nas recorded"];
    edition:album:e -> album:id:w [label="one set of tracks,\nas issued"];
    recording:artist:e -> artist:id:w [label="each recording's\nown artist"];
    album:artist:e -> artist:id:w [label="none for a\ncompilation"];
    album:idr:e -> refs:owner:w [style=dashed, arrowhead=none, label="outside IDs,\nnever keys"];
}
